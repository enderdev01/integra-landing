---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/contact/ContactForm.astro';

const steps = ['Entendemos tus necesidades.', 'Conversamos sobre el alcance.', 'Definimos una propuesta personalizada.'];
---

<BaseLayout page="contacto" mobileBar={false}>
  <div class="mx-auto grid w-full max-w-[1320px] grid-cols-1 items-start gap-7 px-4 pt-6 pb-14 md:gap-14 md:px-6 md:pt-12 lg:grid-cols-[5fr_6fr] lg:gap-20 lg:pt-24 lg:pb-36">
    <section aria-labelledby="ct-title" class="relative mb-9 lg:mb-14">
      <div class="rounded-[34px] border-8 border-lime-deep bg-white p-3">
        <div class="rounded-3xl bg-blue px-6 py-7 text-white sm:px-12 sm:pt-12 sm:pb-[52px]">
          <h1 id="ct-title" class="font-display text-[clamp(34px,3.4vw,50px)] leading-[1.05] font-bold tracking-[-0.015em]">Construyamos tu próximo equipo.</h1>
          <p class="mt-5 max-w-[34ch] font-sans text-[19px] leading-relaxed text-[#e8eff8]">
            Cuéntanos dónde necesitas apoyo. Te ayudaremos a definir el talento, la estructura y el siguiente paso.
          </p>
          <div class="hidden md:block">
            <h2 class="mt-11 mb-4 font-sans text-[13px] font-bold tracking-[0.12em] text-lime-light uppercase">Qué sigue</h2>
            <ol class="grid gap-3.5 font-sans">
              {
                steps.map((step, index) => (
                  <li class="flex items-center gap-3.5 text-[17px] leading-snug">
                    <span aria-hidden="true" class="grid size-8 shrink-0 place-items-center rounded-full bg-lime text-[15px] font-bold text-navy">{index + 1}</span>
                    {step}
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </div>
      <svg aria-hidden="true" width="64" height="60" viewBox="0 0 64 60" class="absolute right-9 -bottom-[50px]">
        <path d="M4 0H52L58 54Z" fill="#FFFFFF"></path>
        <path d="M6 2L58 54L50 2" fill="none" stroke="#95B71E" stroke-width="8" stroke-linejoin="round" stroke-linecap="round"></path>
      </svg>
    </section>

    <ContactForm />

    <section aria-labelledby="qs-m" class="rounded-[20px] bg-white px-5 py-5.5 md:hidden">
      <h2 id="qs-m" class="mb-3.5 font-sans text-[13px] font-bold tracking-[0.12em] text-muted uppercase">Qué sigue</h2>
      <ol class="grid gap-3 font-sans">
        {
          steps.map((step, index) => (
            <li class="flex items-center gap-3.5 text-base leading-snug text-body">
              <span aria-hidden="true" class="grid size-[30px] shrink-0 place-items-center rounded-full bg-lime text-sm font-bold text-navy">{index + 1}</span>
              {step}
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import ServicesOverview from '../components/home/ServicesOverview.astro';
import IndustriesOverview from '../components/home/IndustriesOverview.astro';
---

<BaseLayout page="inicio">
  <Hero />
  <ServicesOverview />
  <IndustriesOverview />
  <div aria-hidden="true" class="relative h-[112px]">
    <div class="absolute bottom-0 -left-6 h-[112px] w-[220px] rounded-tr-[220px_112px] bg-lime"></div>
    <div class="absolute bottom-0 left-[29%] h-[88px] w-[176px] rounded-t-[88px] bg-blue"></div>
  </div>
</BaseLayout>

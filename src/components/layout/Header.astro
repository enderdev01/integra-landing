---
import Logo from '../../assets/brand/integra-logo.svg';
import Icon from '../ui/Icon.astro';
import ServiceIcon from '../ui/ServiceIcon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getNav, type PageId } from '../../config/site';
import { getServices } from '../../content/services';
import { getLocale, routePath, servicesHref, useTranslations } from '../../i18n';

interface Props {
  active?: PageId;
}

const { active } = Astro.props;
const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const nav = getNav(locale);
const services = getServices(locale);
const homeHref = routePath('home', locale);
const servicesIndexHref = routePath('services', locale);
const contactHref = routePath('contact', locale);
const onContact = active === 'contacto';
const linkState = (id: PageId) =>
  id === active
    ? 'font-normal text-blue-ink border-lime-deep'
    : 'font-light text-muted border-transparent';
---

<header data-header class="site-header sticky top-0 z-50 border-b border-line-warm bg-cream font-serif text-ink">
  <div class="mx-auto flex min-h-16 w-full max-w-[1320px] items-center gap-3 py-2 pr-3 pl-4 lg:min-h-[104px] lg:gap-7 lg:px-6 xl:gap-14 lg:py-[18px]">
    <a href={homeHref} aria-label={t.header.homeLabel} class="flex min-h-11 shrink-0 items-center">
      <Logo width={139} height={42} aria-hidden="true" class="h-9 w-auto lg:h-[42px]" />
    </a>

    <nav aria-label={t.header.mainNav} class="hidden flex-1 lg:block">
      <ul class="flex items-center gap-6 xl:gap-9">
        {
          nav.map((item) =>
            item.id === 'servicios' ? (
              <li class="relative flex items-center" data-dropdown>
                <a
                  href={item.href}
                  aria-current={item.id === active ? 'page' : undefined}
                  class:list={['nav-link inline-flex min-h-11 items-center border-b-2 px-0.5 text-xl', linkState(item.id)]}
                >
                  {item.label}
                </a>
                <button
                  type="button"
                  class="dd-toggle ml-0.5 grid h-11 w-8 place-items-center rounded-lg text-muted"
                  aria-label={t.header.viewServices}
                  aria-expanded="false"
                  aria-controls="dd-servicios"
                  data-dropdown-toggle
                >
                  <Icon name="chevron-down" size={18} class="dd-chevron" />
                </button>
                <div class="dd-wrap absolute top-full -left-5 z-[70] pt-2.5">
                  <div id="dd-servicios" class="dd-panel w-[360px] rounded-[18px] border border-[#e3e9ef] bg-white p-2 shadow-[0_24px_48px_-20px_rgb(0_56_92/0.35)]">
                    <ul>
                      {services.map((service) => (
                        <li>
                          <a href={servicesHref(locale, service.slug)} class="dd-item flex min-h-16 items-center gap-3.5 rounded-xl px-3 py-2.5 text-ink">
                            <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-lime-soft">
                              <ServiceIcon name={service.id} width={28} />
                            </span>
                            <span class="grid gap-0.5">
                              <span class="font-display text-[17px] leading-tight font-bold text-blue">{service.name}</span>
                              <span class="font-sans text-[13px] leading-snug text-muted">{service.short}</span>
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                    <a href={servicesIndexHref} class="mt-1 flex min-h-12 items-center justify-between border-t border-[#e3e9ef] px-3 font-sans text-[15px] font-bold text-blue-ink">
                      {t.header.viewAllServices} <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  aria-current={item.id === active ? 'page' : undefined}
                  class:list={['nav-link inline-flex min-h-11 items-center border-b-2 px-0.5 text-xl', linkState(item.id)]}
                >
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <a
      href={contactHref}
      aria-current={onContact ? 'page' : undefined}
      class:list={[
        'talk-cta relative ml-auto hidden min-h-11 shrink-0 items-center rounded-xl border-2 border-lime-deep px-5 py-1.5 text-[19px] font-medium sm:inline-flex lg:ml-0',
        onContact ? 'bg-lime text-navy' : 'bg-white text-[#5b7410]',
      ]}
    >
      {t.header.talk}
      <svg width="16" height="12" viewBox="0 0 16 12" aria-hidden="true" class="absolute right-2.5 -bottom-[11px]">
        <path class="cta-tail" d="M1 0H13L14 11Z" fill={onContact ? '#A3C622' : '#FFFFFF'}></path>
        <path d="M1 0L14 11L13 0" fill="none" stroke="#95B71E" stroke-width="2" stroke-linejoin="round"></path>
      </svg>
    </a>

    <LanguageSwitcher class="ml-auto shrink-0 sm:ml-0" />

    <button
      type="button"
      class="burger grid size-12 shrink-0 place-items-center rounded-xl text-ink lg:hidden"
      aria-label={t.header.openMenu}
      aria-expanded="false"
      aria-controls="menu-movil"
      data-menu-toggle
      data-label-open={t.header.openMenu}
      data-label-close={t.header.closeMenu}
    >
      <Icon name="menu" size={26} class="icon-open" />
      <Icon name="close" size={26} class="icon-close hidden" />
    </button>
  </div>

  <!-- Mobile menu: overlays the page (never pushes it), closed state is
       visibility + inert so open/close are pure compositor transitions -->
  <div class="menu-scrim absolute inset-x-0 top-full h-dvh bg-ink/40 lg:hidden" aria-hidden="true" data-menu-scrim></div>
  <nav
    id="menu-movil"
    aria-label={t.header.mobileNav}
    class="mobile-panel absolute inset-x-0 top-full max-h-[calc(100dvh-65px)] overflow-y-auto overscroll-contain border-t border-line-warm bg-cream px-6 pt-2 pb-6 shadow-[0_24px_40px_-24px_rgb(15_35_70/0.45)] lg:hidden"
    inert
  >
    <ul>
      {
        nav.map((item) =>
          item.id === 'servicios' ? (
            <li class="border-b border-line-warm" data-accordion>
              <div class="flex min-h-14 items-center justify-between">
                <a
                  href={item.href}
                  aria-current={item.id === active ? 'page' : undefined}
                  class:list={['flex min-h-14 flex-1 items-center text-xl', item.id === active ? 'font-normal text-blue-ink' : 'font-light text-muted']}
                >
                  {item.label}
                </a>
                <button
                  type="button"
                  class="dd-toggle -mr-3 grid size-12 place-items-center rounded-xl text-lime-deep"
                  aria-label={t.header.viewServices}
                  aria-expanded={active === 'servicios' ? 'true' : 'false'}
                  aria-controls="m-servicios"
                  data-accordion-toggle
                >
                  <Icon name="chevron-down" size={18} class="dd-chevron" />
                </button>
              </div>
              <div id="m-servicios" class="accordion-panel grid" data-open={active === 'servicios' ? '' : undefined} inert={active !== 'servicios'}>
                <div class="min-h-0 overflow-hidden">
                  <ul class="accordion-list grid gap-0.5 pb-3">
                {services.map((service) => (
                  <li>
                    <a href={servicesHref(locale, service.slug)} class="flex min-h-[52px] items-center gap-3 py-1 pl-1.5 font-sans text-[17px] font-medium text-ink">
                      <span class="grid size-9 shrink-0 place-items-center rounded-[10px] bg-lime-soft">
                        <ServiceIcon name={service.id} width={22} />
                      </span>
                      {service.name}
                    </a>
                  </li>
                ))}
                  </ul>
                </div>
              </div>
            </li>
          ) : (
            <li class="border-b border-line-warm">
              <a
                href={item.href}
                aria-current={item.id === active ? 'page' : undefined}
                class:list={['flex min-h-14 items-center justify-between text-xl', item.id === active ? 'font-normal text-blue-ink' : 'font-light text-muted']}
              >
                {item.label}
                <Icon name="chevron-right" size={20} class="text-lime-deep" />
              </a>
            </li>
          ),
        )
      }
    </ul>
    <a href={contactHref} aria-current={onContact ? 'page' : undefined} class="btn-primary mt-5 w-full">
      {t.header.talk} <Icon name="arrow-right" size={20} />
    </a>
  </nav>
</header>

<style>
  .site-header {
    transition: box-shadow 0.2s ease;
  }
  .site-header[data-scrolled] {
    box-shadow: 0 6px 24px -12px rgb(15 35 70 / 0.35);
  }
  .nav-link {
    transition:
      color 0.15s ease,
      border-color 0.2s ease;
  }

  /* Services dropdown: interruptible transitions, origin at the trigger.
     Visibility lives on the wrapper so the closed panel's area never catches
     the pointer (it sits over the hero and used to open the menu on pass-by). */
  .dd-wrap {
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0s linear 0.18s;
  }
  [data-dropdown][data-open] .dd-wrap {
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }
  .dd-panel {
    transform-origin: top left;
    opacity: 0;
    transform: translateY(-4px) scale(0.98);
    transition:
      opacity 0.18s var(--ease-out),
      transform 0.18s var(--ease-out);
  }
  [data-dropdown][data-open] .dd-panel {
    opacity: 1;
    transform: none;
  }
  :global(.dd-chevron) {
    transition: transform 0.2s var(--ease-out);
  }
  [aria-expanded='true'] > :global(.dd-chevron) {
    transform: rotate(180deg);
  }
  .dd-item,
  .dd-toggle,
  .burger {
    transition:
      background-color 0.15s ease,
      transform 0.16s var(--ease-out);
  }
  .burger:active {
    transform: scale(0.95);
  }
  /* ¡Hablemos!: lifts and fills lime on hover, presses in on tap */
  .talk-cta {
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.16s var(--ease-out);
  }
  .talk-cta .cta-tail {
    transition: fill 0.2s ease;
  }
  .talk-cta:active {
    transform: scale(0.97);
  }
  @media (hover: hover) and (pointer: fine) {
    .talk-cta:hover {
      background: var(--color-lime);
      color: var(--color-navy);
      box-shadow: 0 10px 20px -12px rgb(91 116 16 / 0.7);
      transform: translateY(-2px);
    }
    .talk-cta:hover .cta-tail {
      fill: var(--color-lime);
    }
    .talk-cta:hover:active {
      transform: translateY(0) scale(0.97);
    }
    .nav-link:not([aria-current='page']):hover {
      border-bottom-color: #c9dd7a;
    }
    .nav-link:hover {
      color: var(--color-blue-ink);
    }
    .dd-item:hover {
      background: var(--color-mist);
    }
    .dd-toggle:hover {
      background: #eef2f5;
    }
  }

  /* Mobile menu: an overlay driven by [data-menu-open] on the header.
     Only opacity/transform animate (compositor), visibility flips at the end
     of the exit, so every toggle is interruptible and needs no timers. */
  .mobile-panel,
  .menu-scrim {
    visibility: hidden;
    pointer-events: none;
    opacity: 0;
    transition:
      opacity 0.14s ease,
      transform 0.14s var(--ease-out),
      visibility 0s linear 0.14s;
  }
  .mobile-panel {
    transform: translateY(-6px);
  }
  .site-header[data-menu-open] .mobile-panel,
  .site-header[data-menu-open] .menu-scrim {
    visibility: visible;
    pointer-events: auto;
    opacity: 1;
    transform: none;
    transition-duration: 0.2s, 0.2s, 0s;
    transition-delay: 0s;
  }

  /* Services accordion: height animates via grid rows (0fr -> 1fr) */
  .accordion-panel {
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.22s var(--ease-out);
  }
  .accordion-panel[data-open] {
    grid-template-rows: 1fr;
  }
  .accordion-list {
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .accordion-panel[data-open] .accordion-list {
    opacity: 1;
    transition-delay: 0.05s;
  }

  /* Page behind the open menu does not scroll */
  :global(html[data-menu-open]) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .dd-panel {
      transform: none;
    }
    :global(.dd-chevron),
    .burger:active,
    .talk-cta,
    .talk-cta:hover,
    .talk-cta:active {
      transition: none;
      transform: none;
    }
    .mobile-panel {
      transform: none;
    }
    .accordion-panel {
      transition: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');

  // Shadow once the page scrolls under the sticky header
  const onScroll = () => header?.toggleAttribute('data-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Desktop services dropdown: hover (fine pointers), click and keyboard
  document.querySelectorAll<HTMLElement>('[data-dropdown]').forEach((dropdown) => {
    const toggle = dropdown.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
    const setOpen = (open: boolean) => {
      dropdown.toggleAttribute('data-open', open);
      toggle?.setAttribute('aria-expanded', String(open));
    };
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    // Hover intent: a short delay to open (passing over the item does nothing)
    // and a grace period to close (diagonal moves into the panel don't drop it)
    let timer: number | undefined;
    const schedule = (open: boolean, delay: number) => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => setOpen(open), delay);
    };
    dropdown.addEventListener('pointerenter', () => finePointer.matches && schedule(true, 80));
    dropdown.addEventListener('pointerleave', () => finePointer.matches && schedule(false, 150));
    toggle?.addEventListener('click', () => {
      window.clearTimeout(timer);
      setOpen(!dropdown.hasAttribute('data-open'));
    });
    dropdown.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && dropdown.hasAttribute('data-open')) {
        setOpen(false);
        toggle?.focus();
      }
    });
    dropdown.addEventListener('focusout', (event) => {
      if (!dropdown.contains(event.relatedTarget as Node | null)) setOpen(false);
    });
  });

  // Mobile menu: one attribute drives the CSS; state flips synchronously on
  // tap so the icon and panel answer on the same frame
  const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('menu-movil');
  const setMenu = (open: boolean) => {
    if (!header || !menu || !menuToggle) return;
    if (open === header.hasAttribute('data-menu-open')) return;
    header.toggleAttribute('data-menu-open', open);
    document.documentElement.toggleAttribute('data-menu-open', open);
    menu.inert = !open;
    menuToggle.setAttribute('aria-expanded', String(open));
    menuToggle.setAttribute('aria-label', (open ? menuToggle.dataset.labelClose : menuToggle.dataset.labelOpen) ?? '');
    menuToggle.querySelector('.icon-open')?.classList.toggle('hidden', open);
    menuToggle.querySelector('.icon-close')?.classList.toggle('hidden', !open);
  };
  menuToggle?.addEventListener('click', () => setMenu(!header?.hasAttribute('data-menu-open')));
  document.querySelector('[data-menu-scrim]')?.addEventListener('click', () => setMenu(false));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && header?.hasAttribute('data-menu-open')) {
      setMenu(false);
      menuToggle?.focus();
    }
  });
  // Any link closes the menu (same-page anchors don't reload the page)
  menu?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) setMenu(false);
  });
  // Desktop breakpoint hides the burger; back/forward cache restores state
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => event.matches && setMenu(false));
  window.addEventListener('pageshow', (event) => event.persisted && setMenu(false));

  // Services accordion inside the mobile menu
  document.querySelectorAll<HTMLButtonElement>('[data-accordion-toggle]').forEach((toggle) => {
    const panel = document.getElementById(toggle.getAttribute('aria-controls') ?? '');
    toggle.addEventListener('click', () => {
      if (!panel) return;
      const open = !panel.hasAttribute('data-open');
      panel.toggleAttribute('data-open', open);
      panel.inert = !open;
      toggle.setAttribute('aria-expanded', String(open));
    });
  });
</script>

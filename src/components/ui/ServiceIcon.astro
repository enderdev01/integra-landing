---
/**
 * Service pictograms traced from the client design (lime #A3C622).
 * `cutout` is the color behind the coin / front bubble so they read as layered.
 */
import type { ServiceId } from '../../content/services';

interface Props {
  name: ServiceId;
  width: number;
  cutout?: string;
  class?: string;
}

const { name, width, cutout = '#F4F7F9', class: className } = Astro.props;
const lime = '#A3C622';
const viewBoxes: Record<ServiceId, [number, number]> = {
  ventas: [100, 100],
  va: [100, 72],
  web: [100, 100],
  marketing: [100, 76],
};
const [vw, vh] = viewBoxes[name];
const height = Math.round((width * vh) / vw);
---

<svg
  class={className}
  width={width}
  height={height}
  viewBox={`0 0 ${vw} ${vh}`}
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'ventas' && (
      <g fill="none" stroke={lime} stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="14" y="25" width="60" height="53" rx="4" />
        <rect x="6" y="7" width="75" height="18" rx="4" />
        <path d="M31 9V34L42 27L53 34V9M23 54H38M23 66H38" />
        <circle cx="67" cy="70" r="21" fill={cutout} />
        <path d="M73 61.5c-1.3-2-3.5-3-6-3-3.4 0-5.7 1.8-5.7 4.3s2.3 3.6 5.7 4.3 6 1.9 6 4.6-2.6 4.5-6 4.5c-2.7 0-5-1.1-6.3-3.2M67 54.5v4M67 79.7v4" />
      </g>
    )
  }
  {
    name === 'va' && (
      <>
        <path d="M42 4.5H86A6 6 0 0 1 92 10.5V40C92 46 94 51 96 54C90 52 84 48 80 46H42A6 6 0 0 1 36 40V10.5A6 6 0 0 1 42 4.5Z" fill={lime} />
        <path d="M50 19H83M50 26H83M66 35H83" stroke="#FFFFFF" stroke-width="4.5" stroke-linecap="round" />
        <path d="M15 25H46A6 6 0 0 1 52 31V53A6 6 0 0 1 46 59H17C13 63 9 67 4 69C7 65 9 61 9 57V31A6 6 0 0 1 15 25Z" fill={cutout} stroke={cutout} stroke-width="10" stroke-linejoin="round" />
        <path d="M15 25H46A6 6 0 0 1 52 31V53A6 6 0 0 1 46 59H17C13 63 9 67 4 69C7 65 9 61 9 57V31A6 6 0 0 1 15 25Z" fill={cutout} stroke={lime} stroke-width="5" stroke-linejoin="round" />
        <path d="M19 36H44M19 41.5H44M19 47H36" stroke={lime} stroke-width="3.5" stroke-linecap="round" />
      </>
    )
  }
  {
    name === 'web' && (
      <>
        <path d="M20 8H75A14 14 0 0 1 89 22V62C89 70 92 82 98 91C88 84 78 77 70 72H20A14 14 0 0 1 6 58V22A14 14 0 0 1 20 8Z" fill="none" stroke={lime} stroke-width="6" stroke-linejoin="round" />
        <circle cx="47.5" cy="31" r="9.5" fill={lime} />
        <path d="M30 59V54C30 47 36 44 42 44H53C59 44 65 47 65 54V59Z" fill={lime} />
      </>
    )
  }
  {
    name === 'marketing' && (
      <g transform="translate(4 37) rotate(-18.7)" stroke-width="2" stroke-linejoin="round">
        <path d="M39 0H54A6.5 6.5 0 1 1 67 0H88V40H39V25.5A7.5 7.5 0 1 0 39 12.5Z" fill={lime} stroke={lime} />
        <path d="M0 0H13A6.5 6.5 0 0 0 26 0H39V12.5A7.5 7.5 0 1 1 39 25.5V40H0Z" fill="#141B2D" stroke="#141B2D" />
      </g>
    )
  }
</svg>

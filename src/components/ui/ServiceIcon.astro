---
/** Service pictograms from the client's v3 artwork (lime #A3C522, marketing adds navy). */
import type { ServiceId } from '../../content/services';
import { ARTWORK, type ArtworkName } from './artwork';

interface Props {
  name: ServiceId;
  width: number;
  class?: string;
}

const { name, width, class: className } = Astro.props;
const artworkFor: Record<ServiceId, ArtworkName> = {
  ventas: 'service-ventas',
  va: 'service-va',
  web: 'service-web',
  marketing: 'service-marketing',
};
const art = ARTWORK[artworkFor[name]];
const height = Math.round((width * art.height) / art.width);
---

<svg
  class={className}
  width={width}
  height={height}
  viewBox={`0 0 ${art.width} ${art.height}`}
  fill="#A3C522"
  aria-hidden="true"
  focusable="false"
>
  {art.paths.map((path) => <path d={path.d} fill={'fill' in path ? path.fill : undefined} />)}
</svg>

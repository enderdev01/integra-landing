---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import MobileActionBar from '../components/layout/MobileActionBar.astro';
import { SITE, getSeo, type SeoPageId } from '../config/site';
import { getServices } from '../content/services';
import { getIndustries } from '../content/industries';
import { LOCALE_META, LOCALES, alternates, getLocale, routePath, servicesHref, useTranslations } from '../i18n';

interface Props {
  /** Current section; highlights the menu item. Omit on legal and error pages. */
  page?: SeoPageId;
  /** Overrides the page SEO entry (e.g. legal and error pages) */
  meta?: { title: string; description: string };
  noindex?: boolean;
  /** Show the default thumb-zone bar on mobile. Pages can pass their own via the `mobile-bar` slot. */
  mobileBar?: boolean;
  ogImage?: string;
}

const { page, meta, noindex = false, mobileBar = true, ogImage = '/og-integra.jpg' } = Astro.props;
const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const { title, description } = meta ?? getSeo(page ?? 'inicio', locale);
const absolute = (path: string) => new URL(path, Astro.site);
// Same page in the other language(s); empty for pages that have no twin (404, legal placeholders)
const languageLinks = noindex ? [] : alternates(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const hasCustomBar = Astro.slots.has('mobile-bar');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE.legalName,
  url: absolute(routePath('home', locale)).toString(),
  inLanguage: LOCALE_META[locale].lang,
  logo: new URL('/integra-logo.svg', Astro.site).toString(),
  image: ogImageUrl.toString(),
  telephone: SITE.phone.display,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: SITE.address.city,
    addressRegion: SITE.address.region,
    postalCode: SITE.address.postalCode,
    addressCountry: SITE.address.country,
  },
  ...(SITE.profiles.length > 0 && { sameAs: SITE.profiles }),
  makesOffer: getServices(locale).map((service) => ({
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Service',
      name: service.id === 'ventas' ? t.seo.salesOffer : service.name,
      url: absolute(servicesHref(locale, service.slug)).toString(),
    },
  })),
  areaServed: ['US', 'LATAM'],
  audience: getIndustries(locale).map((industry) => ({ '@type': 'BusinessAudience', audienceType: industry.name })),
};
---

<!doctype html>
<html lang={LOCALE_META[locale].lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          {languageLinks.map(({ locale: lang, path }) => <link rel="alternate" hreflang={LOCALE_META[lang].lang} href={absolute(path)} />)}
          {languageLinks.length > 0 && <link rel="alternate" hreflang="x-default" href={absolute(languageLinks[0].path)} />}
        </>
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#FAF7F6" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={LOCALE_META[locale].og} />
    {LOCALES.filter((lang) => lang !== locale).map((lang) => <meta property="og:locale:alternate" content={LOCALE_META[lang].og} />)}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Preload only what paints above the fold: hero headline (700) and menu (300) -->
    <Font cssVariable="--font-quicksand" preload={[{ weight: 700 }]} />
    <Font cssVariable="--font-roboto" />
    <Font cssVariable="--font-roboto-slab" preload={[{ weight: 300 }]} />
    <Font cssVariable="--font-myriad" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body class="bg-pattern">
    <a href="#contenido" class="skip-link">{t.skipLink}</a>
    <div class:list={['flex min-h-dvh flex-col overflow-x-clip', (mobileBar || hasCustomBar) && 'pb-[calc(76px+env(safe-area-inset-bottom))] md:pb-0']}>
      <Header active={page} />
      <main id="contenido" class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>
    {hasCustomBar ? <slot name="mobile-bar" /> : mobileBar && <MobileActionBar />}
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 100;
    padding: 12px 18px;
    border-radius: 12px;
    background: var(--color-blue);
    color: #fff;
    font-family: var(--font-sans);
    font-weight: 700;
  }
  .skip-link:focus {
    top: 12px;
  }
</style>

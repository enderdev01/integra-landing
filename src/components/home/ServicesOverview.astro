---
import Icon from '../ui/Icon.astro';
import ServiceIcon from '../ui/ServiceIcon.astro';
import { SERVICES } from '../../content/services';

const iconWidth = { ventas: 92, va: 150, web: 92, marketing: 150 } as const;
---

<section aria-labelledby="services-title" class="relative mt-10 pb-16 md:mt-[72px] md:pb-28">
  <!-- Lime band, same treatment as the /servicios header band -->
  <div class="mx-auto w-full max-w-[1440px]">
    <div class="svc-band bg-lime">
      <h2
        id="services-title"
        class="mx-auto max-w-[1320px] font-display text-[clamp(26px,3.1vw,44px)] leading-[1.1] font-bold tracking-[-0.005em] text-navy uppercase"
      >
        Servicios para potenciar tu operación
      </h2>
    </div>
  </div>

  <div class="relative mx-auto w-full max-w-[1320px] px-4 md:px-6">
    <div class="grid grid-cols-1 gap-14 pt-12 md:grid-cols-2 md:gap-x-[72px] md:gap-y-20 md:pt-24 xl:px-24">
      {
        SERVICES.map((service) => (
          <article class="reveal flex flex-col gap-3.5 md:gap-5">
            <div class="flex items-center gap-4">
              <ServiceIcon name={service.id} width={iconWidth[service.id]} class="h-auto w-16 shrink-0 md:w-auto" />
              <h3 class="font-display text-[30px] leading-none font-bold tracking-[-0.015em] text-blue md:text-[clamp(40px,4vw,58px)]">{service.name}</h3>
            </div>
            <p class="max-w-[32ch] text-[19px] leading-normal font-medium text-body">{service.lead}</p>
            <a href={`/servicios#${service.slug}`} class="btn-primary mt-auto justify-between self-stretch md:justify-center md:self-start">
              {service.cta}
              <Icon name="arrow-right" />
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .svc-band {
    border-bottom-right-radius: 120px;
    padding: 44px 24px;
    text-align: center;
  }
  @media (max-width: 960px) {
    .svc-band {
      border-bottom-right-radius: 64px;
    }
  }
  @media (max-width: 560px) {
    .svc-band {
      padding: 32px 16px;
      text-align: left;
      border-bottom-right-radius: 40px;
    }
  }
</style>


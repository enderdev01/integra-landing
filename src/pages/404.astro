---
// Static hosting serves one 404 for every path, so it is Spanish (the default
// language) with an English pointer underneath.
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { routePath, useTranslations } from '../i18n';

const t = useTranslations('es').notFound;
const en = useTranslations('en').notFound;
---

<BaseLayout meta={{ title: t.metaTitle, description: t.metaDescription }} noindex>
  <section class="mx-auto flex w-full max-w-[760px] flex-col items-start px-4 pt-14 pb-24 md:px-6 md:pt-24">
    <p class="font-sans text-sm font-bold tracking-[0.12em] text-muted uppercase">{t.eyebrow}</p>
    <h1 class="mt-3 font-display text-[clamp(34px,4.4vw,56px)] leading-tight font-bold text-blue">{t.title}</h1>
    <p class="mt-5 max-w-[46ch] text-lg leading-relaxed text-body">{t.body}</p>
    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
      <a href={routePath('home', 'es')} class="btn-primary">{t.home} <Icon name="arrow-right" /></a>
      <a href={routePath('schedule', 'es')} class="inline-flex min-h-12 items-center font-sans font-bold text-blue-ink">{t.book}</a>
    </div>
    <p lang="en" class="mt-10 max-w-[46ch] border-t border-line-warm pt-6 font-sans text-base text-body">
      {en.title}. <a href={routePath('home', 'en')} hreflang="en" class="inline-flex min-h-11 items-center font-bold text-blue-ink">{en.home} →</a>
    </p>
  </section>
</BaseLayout>

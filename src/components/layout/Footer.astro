---
import Icon from '../ui/Icon.astro';
import { SITE } from '../../config/site';
import { format, getLocale, legalPath, useTranslations } from '../../i18n';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="relative z-10 bg-graphite-dark font-footer text-white">
  <div class="bg-graphite">
    <div class="mx-auto flex w-full max-w-[1320px] flex-wrap items-start gap-x-[72px] gap-y-6 px-5 pt-8 pb-7 sm:px-6 sm:pt-11 sm:pb-10">
      <div class="min-w-0 flex-[1_1_240px]">
        <h2 class="mb-2.5 text-[15px] font-bold tracking-[0.04em] uppercase">{format(t.footer.contactTitle, { name: SITE.legalName })}</h2>
        <address class="text-[15px] leading-[1.65] tracking-[0.02em] text-[#e7e8ea] uppercase not-italic">
          {SITE.address.display[0]}<br />{SITE.address.display[1]}
        </address>
      </div>

      <div class="min-w-0 flex-[1_1_300px]">
        <h2 class="mb-2.5 text-[15px] font-bold tracking-[0.04em] uppercase">{t.footer.customerCare}</h2>
        <p class="text-[15px] tracking-[0.02em] text-[#e7e8ea]">
          <a href={SITE.phone.href} class="inline-flex min-h-11 items-center text-white no-underline">{SITE.phone.display}</a>
        </p>
      </div>

      <div class="flex flex-col items-start gap-2 sm:ml-auto sm:items-center">
        <h2 class="text-[17px] font-semibold">{t.footer.follow}</h2>
        <ul class="flex gap-2">
          {
            SITE.social.map((network) => (
              <li>
                <a href={network.href} aria-label={network.label} class="social grid size-12 place-items-center rounded-xl text-white" rel="noopener" target="_blank">
                  <Icon name={network.icon} size={26} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex w-full max-w-[1320px] flex-wrap items-center justify-between gap-x-6 gap-y-1 px-5 py-3 text-[13px] text-[#c9cbcf] sm:px-6">
      <p class="py-2">© {year} {SITE.legalName} {t.footer.rights}</p>
      <a href={legalPath('terms-of-service', locale)} class="inline-flex min-h-11 items-center text-[#c9cbcf] underline decoration-white/30 underline-offset-4 hover:text-white">{t.footer.terms}</a>
    </div>
  </div>
</footer>

<style>
  .social {
    transition:
      background-color 0.15s ease,
      transform 0.16s var(--ease-out);
  }
  .social:active {
    transform: scale(0.95);
  }
  @media (prefers-reduced-motion: reduce) {
    .social:active {
      transform: none;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .social:hover {
      background: rgb(255 255 255 / 0.08);
    }
  }
</style>

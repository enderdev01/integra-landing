---
import BaseLayout from '../layouts/BaseLayout.astro';
import Chevrons from '../components/ui/Chevrons.astro';
import Icon from '../components/ui/Icon.astro';
import ServiceIcon from '../components/ui/ServiceIcon.astro';
import { SERVICES } from '../content/services';

const cardIconWidth = { ventas: 60, va: 84, web: 60, marketing: 79 } as const;
const first = SERVICES[0];
---

<BaseLayout page="agendar">
  <div class="relative mx-auto w-full max-w-[1440px] pb-14 md:pb-28">
    <div aria-hidden="true" class="absolute top-12 right-[60px] -left-[2000px] hidden h-[200px] rounded-tr-[260px] border-t-[112px] border-r-[112px] border-lime xl:block"></div>
    <div aria-hidden="true" class="absolute top-[247px] -right-[2000px] hidden h-[166px] w-[2172px] rounded-bl-[166px] border-b-[112px] border-l-[112px] border-lime xl:block"></div>
    <!-- Chevron groups from the client artwork, on the band's straight run -->
    <Chevrons size={112} class="absolute top-12 left-[calc(50%-50vw+31px)] hidden xl:block" />
    <Chevrons dir="left" size={112} class="absolute top-12 right-[320px] hidden xl:block" />

    <header class="relative px-4 pt-6 md:px-6 md:pt-10 xl:pt-12 xl:pr-44 xl:text-center">
      <div class="relative -ml-4 overflow-hidden rounded-r-[36px] bg-lime md:-ml-6 xl:ml-0 xl:overflow-visible xl:rounded-none xl:bg-transparent">
        <span aria-hidden="true" class="absolute inset-y-0 right-0 w-[104px] overflow-hidden xl:hidden"><Chevrons dir="left" size={112} class="absolute top-1/2 right-0 -translate-y-1/2" /></span>
        <h1 class="relative px-5 py-4 pr-[104px] font-display text-[clamp(28px,3.1vw,44px)] leading-tight font-bold text-blue uppercase xl:flex xl:h-28 xl:items-center xl:justify-center xl:p-0">
          <span><span class="text-white">Agenda</span> una <span class="text-white">llamada</span></span>
        </h1>
      </div>
      <p class="mt-4 max-w-[46ch] text-base leading-normal font-medium text-copy md:text-[19px] xl:mx-auto xl:mt-6">
        Elige el servicio y reserva tu cita con el especialista indicado. Cada servicio tiene su propio calendario.
      </p>
    </header>

    <div class="relative mx-auto w-full max-w-[1180px] px-4 md:px-6">
      <!-- Step 1: service -->
      <fieldset class="mt-7 md:mt-[72px]" data-service-picker>
        <legend class="mb-3 font-sans text-sm font-bold tracking-[0.12em] text-copy uppercase md:mb-[18px]">1 · Elige tu cita</legend>
        <div class="grid grid-cols-2 gap-2 md:gap-4 lg:grid-cols-4">
          {
            SERVICES.map((service, index) => (
              <label class="svc-card relative flex cursor-pointer flex-col items-start gap-2.5 rounded-[14px] border-2 border-[#d6dee6] bg-white/70 px-3 py-3 text-left md:min-h-[196px] md:rounded-[20px] md:px-5 md:py-[22px]">
                <input type="radio" name="servicio" value={service.slug} checked={index === 0} class="sr-only" />
                <ServiceIcon name={service.id} width={cardIconWidth[service.id]} cutout="#FFFFFF" class="hidden md:block" />
                <span class="hidden font-sans text-[13px] font-bold tracking-[0.1em] text-copy uppercase md:block">Cita de</span>
                <span class="font-sans text-[15px] leading-tight font-semibold text-ink md:-mt-1.5 md:font-display md:text-2xl md:font-bold md:text-blue">{service.name}</span>
                <span class="hidden font-serif text-[15px] leading-snug text-copy md:block">{service.short}.</span>
                <span aria-hidden="true" class="check absolute top-4 right-4 hidden size-7 place-items-center rounded-full bg-lime text-navy md:grid">
                  <Icon name="check" size={16} />
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <!-- Step 2: calendar -->
      <section aria-labelledby="step2" class="mt-7 md:mt-14">
        <h2 id="step2" class="mb-3 font-sans text-sm font-bold tracking-[0.12em] text-copy uppercase md:mb-[18px]">2 · Elige día y hora</h2>
        <div class="grid grid-cols-1 items-stretch gap-6 lg:grid-cols-[5fr_7fr]">
          {
            SERVICES.map((service, index) => (
              <aside class="hidden flex-col gap-[18px] rounded-3xl bg-blue px-9 py-10 text-white" data-summary={service.slug} data-visible={index === 0 ? '' : undefined}>
                <span class="font-sans text-[13px] font-bold tracking-[0.12em] text-lime-light uppercase">Tu cita</span>
                <h3 class="font-display text-[clamp(30px,2.8vw,40px)] leading-[1.05] font-bold tracking-[-0.015em]">Cita de {service.name}</h3>
                <p class="text-[17px] leading-relaxed text-[#e8eff8]">{service.bookingLead}</p>
                <div>
                  <p class="mb-2.5 font-sans text-sm font-bold">En la llamada revisamos:</p>
                  <ul class="grid gap-2 text-base leading-snug text-[#e8eff8]">
                    {service.bullets.map((bullet) => (
                      <li class="flex items-start gap-3">
                        <span aria-hidden="true" class="mt-2.5 size-[7px] shrink-0 rounded-full bg-lime" />
                        {bullet}
                      </li>
                    ))}
                  </ul>
                </div>
              </aside>
            ))
          }

          <div id="calendario" class="relative scroll-mt-24 overflow-hidden rounded-3xl bg-white shadow-[0_24px_60px_-36px_rgb(20_45_85/0.45)]">
            {
              SERVICES.map((service, index) => (
                <div data-booking={service.slug} data-active={index === 0 ? '' : undefined} inert={index !== 0}>
                  {service.bookingUrl ? (
                    <iframe
                      data-src={service.bookingUrl}
                      src={index === 0 ? service.bookingUrl : undefined}
                      title={`Calendario de reservas · Cita de ${service.name}`}
                      class="block h-[760px] w-full border-0"
                      scrolling="no"
                    />
                  ) : (
                    <div class="flex min-h-[420px] flex-col items-start justify-center gap-4 px-7 py-10 font-sans md:px-10">
                      <p class="text-lg font-bold text-ink">Calendario de la Cita de {service.name}</p>
                      <p class="max-w-[46ch] font-serif text-base leading-relaxed text-copy">
                        Estamos habilitando las reservas en línea para este servicio. Escríbenos y te contactamos para coordinar la llamada.
                      </p>
                      <a href="/contacto" class="btn-primary">
                        Ir al formulario de contacto <Icon name="arrow-right" />
                      </a>
                    </div>
                  )}
                </div>
              ))
            }
          </div>
        </div>
        <p class="mt-7 text-center text-base text-copy">
          ¿Prefieres escribirnos? <a href="/contacto" class="inline-flex min-h-11 items-center font-bold text-blue-ink">Ir al formulario de contacto →</a>
        </p>
      </section>
    </div>
  </div>

  <nav slot="mobile-bar" aria-label="Tu selección" class="booking-bar fixed inset-x-0 bottom-0 z-[60] flex items-center gap-3 border-t border-line-warm px-4 pt-2.5 font-sans md:hidden">
    <div class="min-w-0 flex-1">
      <p class="truncate text-xs font-bold tracking-[0.08em] text-copy uppercase">Tu cita</p>
      <p class="truncate text-[15px] font-bold text-ink" data-bar-label>Cita de {first.name}</p>
    </div>
    <a href="#calendario" class="btn-primary min-h-[52px] shrink-0 px-5 text-base">Ver calendario <Icon name="arrow-right" size={20} /></a>
  </nav>
</BaseLayout>

<style>
  .svc-card {
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.16s var(--ease-out);
  }
  .svc-card:active {
    transform: scale(0.97);
  }
  .svc-card:has(:checked) {
    border-color: var(--color-lime-deep);
    background: #fff;
    box-shadow: 0 18px 40px -26px rgb(20 45 85 / 0.45);
  }
  .svc-card:has(:focus-visible) {
    outline: 3px solid var(--color-blue-ink);
    outline-offset: 3px;
  }
  .check {
    opacity: 0;
    transform: scale(0.9);
    transition:
      opacity 0.15s ease,
      transform 0.15s var(--ease-out);
  }
  .svc-card:has(:checked) .check {
    opacity: 1;
    transform: none;
  }
  @media (max-width: 767px) {
    .svc-card:has(:checked) {
      border-color: var(--color-blue);
      background: var(--color-blue);
    }
    .svc-card:has(:checked) span {
      color: #fff;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .svc-card:hover {
      border-color: var(--color-lime);
    }
  }
  @media (min-width: 1024px) {
    [data-summary][data-visible] {
      display: flex;
    }
  }
  /*
   * Calendar swap between services. Inactive panels stay mounted and keep their
   * width (no display:none), so each GoHighLevel widget loads once and never
   * re-renders when the visitor switches back to it.
   */
  [data-booking] {
    transition:
      opacity 0.2s ease,
      visibility 0.2s;
  }
  [data-booking]:not([data-active]) {
    position: absolute;
    inset: 0 0 auto;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .booking-bar {
    padding-bottom: calc(10px + env(safe-area-inset-bottom));
    background: rgb(250 247 246 / 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  @media (prefers-reduced-motion: reduce) {
    .svc-card:active {
      transform: none;
    }
  }
</style>

<script>
  const picker = document.querySelector<HTMLFieldSetElement>('[data-service-picker]');
  const barLabel = document.querySelector<HTMLElement>('[data-bar-label]');
  const frames = [...document.querySelectorAll<HTMLIFrameElement>('[data-booking] iframe[data-src]')];

  const loadFrame = (panel: HTMLElement) => {
    const frame = panel.querySelector<HTMLIFrameElement>('iframe[data-src]');
    if (frame && !frame.getAttribute('src')) frame.src = frame.dataset.src!;
  };

  // The GoHighLevel widget reports its content height; grow the iframe to fit so it never scrolls inside
  window.addEventListener('message', (event) => {
    const frame = frames.find((f) => f.contentWindow === event.source);
    if (!frame) return;
    let data: unknown = event.data;
    if (typeof data === 'string') {
      try {
        data = JSON.parse(data);
      } catch {
        return;
      }
    }
    if (!Array.isArray(data) || data[0] !== 'highlevel.setHeight') return;
    const height = Number((data[1] as { height?: unknown } | undefined)?.height);
    if (height > 0) frame.style.height = `${Math.ceil(height)}px`;
  });

  // Warm up the other calendars once the page is idle, so switching service is instant
  const preload = () => document.querySelectorAll<HTMLElement>('[data-booking]').forEach(loadFrame);
  window.addEventListener('load', () => ('requestIdleCallback' in window ? requestIdleCallback(preload, { timeout: 3000 }) : setTimeout(preload, 1500)), { once: true });

  const select = (slug: string, updateUrl: boolean) => {
    const radio = picker?.querySelector<HTMLInputElement>(`input[value="${CSS.escape(slug)}"]`);
    if (!radio) return;
    radio.checked = true;
    document.querySelectorAll<HTMLElement>('[data-summary]').forEach((el) => el.toggleAttribute('data-visible', el.dataset.summary === slug));
    document.querySelectorAll<HTMLElement>('[data-booking]').forEach((panel) => {
      const active = panel.dataset.booking === slug;
      panel.toggleAttribute('data-active', active);
      panel.inert = !active;
      if (active) loadFrame(panel);
    });
    const name = radio.closest('label')?.querySelector('.font-semibold')?.textContent?.trim();
    if (barLabel && name) barLabel.textContent = `Cita de ${name}`;
    if (updateUrl) {
      const url = new URL(window.location.href);
      url.searchParams.set('servicio', slug);
      history.replaceState(null, '', url);
    }
  };

  picker?.addEventListener('change', (event) => {
    const target = event.target as HTMLInputElement;
    if (target.name === 'servicio') select(target.value, true);
  });

  const fromUrl = new URL(window.location.href).searchParams.get('servicio');
  if (fromUrl) select(fromUrl, false);
</script>

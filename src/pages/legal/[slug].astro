---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';

export function getStaticPaths() {
  return SITE.legal.map((doc) => ({
    params: { slug: doc.href.replace('/legal/', '') },
    props: { title: doc.label },
  }));
}

const { title } = Astro.props;
---

<!-- Placeholder until the client provides the legal text; kept out of search results. -->
<BaseLayout meta={{ title: `${title} | Integra`, description: `${title} de ${SITE.legalName}.` }} noindex>
  <section class="mx-auto w-full max-w-[760px] px-4 pt-12 pb-24 md:px-6 md:pt-20">
    <h1 class="font-display text-[clamp(32px,4vw,48px)] leading-tight font-bold text-blue">{title}</h1>
    <p class="mt-6 text-lg leading-relaxed text-body">
      Estamos actualizando este documento. Si necesitas información sobre {title.toLowerCase()} de {SITE.legalName}, escríbenos y te responderemos a la brevedad.
    </p>
    <a href="/contacto" class="btn-primary mt-8">Ir a Contacto</a>
  </section>
</BaseLayout>

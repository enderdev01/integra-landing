---
/** Small interface icons (stroke icons inherit `currentColor`). */
type IconName =
  | 'arrow-right'
  | 'chevron-down'
  | 'chevron-right'
  | 'chevron-left'
  | 'menu'
  | 'close'
  | 'phone'
  | 'check'
  | 'alert'
  | 'pause'
  | 'play'
  | 'facebook'
  | 'instagram'
  | 'youtube'
  | 'linkedin'
  | 'x';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 22, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  fill="none"
  stroke="currentColor"
  stroke-width="2.4"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {name === 'arrow-right' && <path d="M4 12h15M13 6l6 6-6 6" stroke-width="2.6" />}
  {name === 'chevron-down' && <path d="M6 9l6 6 6-6" />}
  {name === 'chevron-right' && <path d="M9 6l6 6-6 6" />}
  {name === 'chevron-left' && <path d="M15 6l-6 6 6 6" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6L6 18" />}
  {name === 'phone' && <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" stroke-width="2.2" />}
  {name === 'check' && <path d="M5 12.5l4.5 4.5L19 7.5" stroke-width="2.8" />}
  {name === 'pause' && <path d="M9 6v12M15 6v12" stroke-width="2.6" />}
  {name === 'play' && <path d="M8 5.5v13l10.5-6.5z" fill="currentColor" stroke-width="1.6" />}
  {
    name === 'alert' && (
      <>
        <circle cx="12" cy="12" r="9" stroke-width="2.2" />
        <path d="M12 7.5v5.5M12 16.5v.01" stroke-width="2.2" />
      </>
    )
  }
  {
    name === 'facebook' && (
      <path
        d="M13.5 22v-8.2h2.8l.4-3.3h-3.2V8.4c0-.9.3-1.6 1.6-1.6h1.7V3.9c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.4H7.3v3.3h2.8V22z"
        fill="currentColor"
        stroke="none"
      />
    )
  }
  {
    name === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" stroke-width="2" />
        <circle cx="12" cy="12" r="4.2" stroke-width="2" />
        <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'youtube' && (
      <>
        <rect x="2" y="5" width="20" height="14" rx="4.5" fill="currentColor" stroke="none" />
        <path d="M10 9v6l5.2-3z" fill="var(--icon-cutout, #4B4C50)" stroke="none" />
      </>
    )
  }
  {
    name === 'linkedin' && (
      <>
        <rect x="2.5" y="2.5" width="19" height="19" rx="3.5" fill="currentColor" stroke="none" />
        <rect x="6.5" y="10" width="2.6" height="7.5" fill="var(--icon-cutout, #4B4C50)" stroke="none" />
        <circle cx="7.8" cy="7.2" r="1.5" fill="var(--icon-cutout, #4B4C50)" stroke="none" />
        <path
          d="M11 10h2.5v1.1c.5-.8 1.4-1.3 2.6-1.3 2 0 3 1.2 3 3.6v4.1h-2.6v-3.8c0-1.1-.4-1.7-1.3-1.7s-1.6.6-1.6 1.8v3.7H11z"
          fill="var(--icon-cutout, #4B4C50)"
          stroke="none"
        />
      </>
    )
  }
  {name === 'x' && <path d="M4 4l16 16M20 4L4 20" stroke-width="2.6" />}
</svg>

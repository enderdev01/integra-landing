---
/**
 * Small interface icons (stroke icons inherit `currentColor`).
 * The arrow and social marks come from the client's v3 artwork.
 */
import Artwork from './Artwork.astro';

const ARTWORK_ICONS = ['arrow-right', 'facebook', 'instagram', 'linkedin'] as const;
type ArtworkIcon = (typeof ARTWORK_ICONS)[number];
const isArtwork = (value: string): value is ArtworkIcon => (ARTWORK_ICONS as readonly string[]).includes(value);

type IconName =
  | 'arrow-right'
  | 'chevron-down'
  | 'chevron-right'
  | 'chevron-left'
  | 'menu'
  | 'close'
  | 'phone'
  | 'check'
  | 'alert'
  | 'pause'
  | 'play'
  | 'facebook'
  | 'instagram'
  | 'linkedin';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 22, class: className } = Astro.props;
---

{isArtwork(name) ? (
<Artwork name={name} size={size} class={className} />
) : (
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  fill="none"
  stroke="currentColor"
  stroke-width="2.4"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {name === 'chevron-down' && <path d="M6 9l6 6 6-6" />}
  {name === 'chevron-right' && <path d="M9 6l6 6-6 6" />}
  {name === 'chevron-left' && <path d="M15 6l-6 6 6 6" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6L6 18" />}
  {name === 'phone' && <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" stroke-width="2.2" />}
  {name === 'check' && <path d="M5 12.5l4.5 4.5L19 7.5" stroke-width="2.8" />}
  {name === 'pause' && <path d="M9 6v12M15 6v12" stroke-width="2.6" />}
  {name === 'play' && <path d="M8 5.5v13l10.5-6.5z" fill="currentColor" stroke-width="1.6" />}
  {
    name === 'alert' && (
      <>
        <circle cx="12" cy="12" r="9" stroke-width="2.2" />
        <path d="M12 7.5v5.5M12 16.5v.01" stroke-width="2.2" />
      </>
    )
  }
</svg>
)}

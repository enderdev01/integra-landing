---
/**
 * ES | EN toggle. Plain links to the same page in the other language (crawlable,
 * works without JS); the script only remembers the choice so the server stops
 * auto-detecting the browser language for this visitor.
 */
import { LANG_COOKIE, LOCALES, LOCALE_META, alternatePath, getLocale, useTranslations } from '../../i18n';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const locale = getLocale(Astro.url);
const t = useTranslations(locale);
---

<nav aria-label={t.switcher.label} class:list={['lang-switch', className]} data-lang-switch data-cookie={LANG_COOKIE}>
  <ul class="flex items-center gap-0.5 rounded-full border-[1.5px] border-[#d6dee6] bg-white p-0.5 font-sans text-sm font-bold">
    {
      LOCALES.map((code) =>
        code === locale ? (
          <li>
            <span aria-current="true" lang={LOCALE_META[code].lang} class="grid h-10 min-w-10 place-items-center rounded-full bg-lime px-2 text-navy">
              {code.toUpperCase()}
            </span>
          </li>
        ) : (
          <li>
            <a
              href={alternatePath(Astro.url.pathname, code)}
              hreflang={LOCALE_META[code].lang}
              lang={LOCALE_META[code].lang}
              aria-label={LOCALE_META[code].name}
              data-lang={code}
              class="lang-link grid h-10 min-w-10 place-items-center rounded-full px-2 text-muted no-underline"
            >
              {code.toUpperCase()}
            </a>
          </li>
        ),
      )
    }
  </ul>
</nav>

<style>
  .lang-link {
    transition:
      background-color 0.15s ease,
      color 0.15s ease,
      transform 0.16s var(--ease-out);
  }
  .lang-link:active {
    transform: scale(0.95);
  }
  @media (hover: hover) and (pointer: fine) {
    .lang-link:hover {
      background: var(--color-mist);
      color: var(--color-blue-ink);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lang-link:active {
      transform: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-lang-switch]').forEach((nav) => {
    const cookie = nav.dataset.cookie ?? 'lang';
    nav.querySelectorAll<HTMLAnchorElement>('a[data-lang]').forEach((link) => {
      const base = link.getAttribute('href') ?? '/';
      const remember = () => {
        document.cookie = `${cookie}=${link.dataset.lang}; path=/; max-age=31536000; samesite=lax`;
        // Keep ?servicio=… and #anchors when switching language
        link.href = base + window.location.search + window.location.hash;
      };
      link.addEventListener('click', remember);
      link.addEventListener('auxclick', remember);
    });
  });
</script>
